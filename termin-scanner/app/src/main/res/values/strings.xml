<resources>
    <string name="app_name">Termin-Scanner</string>
    <string name="share_target_label">Termin erkennen</string>

    <!-- Start -->
    <string name="start_title">Termine aus Dokumenten</string>
    <string name="start_intro">Fotografiere einen Brief, eine Einladung oder einen Terminzettel. Die App erkennt Datum, Uhrzeit, Titel und Ort und zeigt dir alles zur Prüfung an. Erst nach deiner Bestätigung wird etwas in den Kalender eingetragen.</string>
    <string name="start_take_photo">Dokument fotografieren</string>
    <string name="start_pick_image">Bild aus Galerie wählen</string>
    <string name="start_privacy">Die Texterkennung läuft komplett auf deinem Handy. Das Foto wird nicht hochgeladen.</string>
    <string name="start_tips_title">Tipps für gute Ergebnisse</string>
    <string name="start_tips">• Dokument gerade und vollständig aufnehmen\n• Auf gute Beleuchtung achten, keine Schatten\n• Du kannst Bilder auch aus anderen Apps über „Teilen“ an den Termin-Scanner senden</string>
    <string name="error_no_camera">Keine Kamera-App gefunden.</string>

    <!-- Verarbeitung -->
    <string name="processing">Dokument wird gelesen …</string>

    <!-- Prüfen -->
    <string name="review_title">Termine prüfen</string>
    <string name="review_found_one">1 möglicher Termin erkannt. Bitte prüfen und bei Bedarf korrigieren.</string>
    <string name="review_found_many">%1$d mögliche Termine erkannt. Wähle aus, was eingetragen werden soll.</string>
    <string name="review_none_title">Kein Termin erkannt</string>
    <string name="review_none_text">Im Dokument wurde kein Datum gefunden. Du kannst einen Termin manuell anlegen oder ein neues Foto aufnehmen.</string>
    <string name="review_add">Termin manuell hinzufügen</string>
