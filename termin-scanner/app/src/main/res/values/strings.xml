    <string name="review_title_missing">Bitte bei allen ausgewählten Terminen einen Titel eingeben.</string>
    <string name="back">Zurück</string>

    <!-- Kalender -->
    <string name="calendar_target">Eintragen in</string>
    <string name="calendar_permission_title">Zugriff auf den Kalender</string>
    <string name="calendar_permission_text">Damit die App Termine direkt in deinen Google Kalender bzw. Handy-Kalender eintragen kann, braucht sie die Kalender-Berechtigung. Ohne Berechtigung öffnet sich stattdessen deine Kalender-App mit dem vorausgefüllten Termin.</string>
    <string name="calendar_permission_grant">Kalenderzugriff erlauben</string>
    <string name="calendar_none">Kein beschreibbarer Kalender gefunden. Füge in den Android-Einstellungen ein Google-Konto hinzu oder trage über die Kalender-App ein.</string>

