{
  "manifest_version": 3,
  "name": "Audio-Mitschnitt",
  "version": "1.0.2",
  "description": "Nimmt den Ton des aktuellen Tabs auf und speichert ihn als MP3.",
  "minimum_chrome_version": "116",
  "permissions": ["tabCapture", "offscreen", "downloads", "storage", "activeTab"],
  "background": { "service_worker": "chrome/background.js" },
  "action": {
    "default_title": "Audio-Mitschnitt",
    "default_popup": "popup/popup.html",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" }
  },
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" }
}
