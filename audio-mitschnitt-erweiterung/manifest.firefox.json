{
  "manifest_version": 2,
  "name": "Audio-Mitschnitt",
  "version": "1.1.0",
  "description": "Nimmt den Ton des aktuellen Tabs auf und speichert ihn als MP3.",
  "browser_specific_settings": {
    "gecko": {
      "id": "audio-mitschnitt@softpal.ai",
      "strict_min_version": "115.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  },
  "permissions": ["activeTab", "tabs", "downloads", "storage", "<all_urls>"],
  "background": { "page": "firefox/background.html", "persistent": true },
  "browser_action": {
    "default_title": "Audio-Mitschnitt",
    "default_popup": "popup/popup.html",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" }
  },
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" }
}
